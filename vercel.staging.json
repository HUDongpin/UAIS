{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/observability/staging-inp/purge-expired",
      "schedule": "17 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "main": true
    }
  }
}
