# UAIS redacted environment template
# Copy this file to .env.local for local use. Keep provider values server-only.
# B-21 env surface: see docs/env-surface.md before adding or promoting names.
# Do not expose API keys, tokens, passwords, or secrets through NEXT_PUBLIC_* variables.

UAIS_LIVE_AI_APPROVAL_TOKEN=
UAIS_AI_ACCESS_SIGNING_SECRET=
UAIS_APP_SESSION_SIGNING_SECRET=
UAIS_APP_AUTH_PROVIDER=
UAIS_APP_AUTH_PROVIDER_URL=
UAIS_APP_AUTH_PROVIDER_TOKEN=
UAIS_CORE_DATABASE_URL=
UAIS_LANGGRAPH_PERSISTENCE_BACKEND=
UAIS_TEACHER_AUTH_PROVIDER=
UAIS_TEACHER_AUTH_SESSION_SIGNING_SECRET=
UAIS_TEACHER_AUTH_ISSUER_SECRET=
UAIS_TEACHER_AUTH_OIDC_ISSUER=
UAIS_TEACHER_AUTH_OIDC_AUDIENCE=
UAIS_TEACHER_AUTH_OIDC_JWKS_URL=
UAIS_TEACHER_AUTH_OIDC_TEACHER_ID_CLAIM=
UAIS_TEACHER_AI_OWNERSHIP_BACKEND=
UAIS_TEACHER_AI_OWNERSHIP_DIR=
UAIS_VOICE_LIFECYCLE_AUDIT_BACKEND=
UAIS_TEACHING_OPERATIONS_BACKEND=
UAIS_TEACHING_COURSE_MANAGEMENT_BACKEND=
UAIS_TEACHING_COURSE_ASSETS_BACKEND=
UAIS_EXTERNAL_STORAGE_BASE_URL=
UAIS_EXTERNAL_STORAGE_ACCESS_TOKEN=
UAIS_EXTERNAL_STORAGE_SERVICE_MODE=
UAIS_EXTERNAL_STORAGE_SERVICE_DATA_DIR=
UAIS_EXTERNAL_STORAGE_DATA_DIR=
UAIS_EXTERNAL_STORAGE_DATABASE_ADAPTER_PROVIDER_CLASS=
UAIS_EXTERNAL_STORAGE_DATABASE_ADAPTER_MIGRATION_STATUS=
UAIS_EXTERNAL_STORAGE_DATABASE_ADAPTER_BACKUP_POLICY=
UAIS_EXTERNAL_STORAGE_DATABASE_ADAPTER_CONCURRENCY_CONTROL=
UAIS_COLLABORATION_INVITE_EMAIL_PROVIDER=
UAIS_COLLABORATION_INVITE_EMAIL_PROVIDER_URL=
UAIS_COLLABORATION_INVITE_EMAIL_PROVIDER_TOKEN=
UAIS_COLLABORATION_INVITE_EMAIL_CALLBACK_TOKEN=
UAIS_STUDENT_ROSTER_SYNC_PROVIDER=
UAIS_STUDENT_ROSTER_SYNC_PROVIDER_URL=
UAIS_STUDENT_ROSTER_SYNC_PROVIDER_TOKEN=
UAIS_KNOWLEDGE_INDEX_SYNC_PROVIDER=
UAIS_KNOWLEDGE_INDEX_SYNC_PROVIDER_URL=
UAIS_KNOWLEDGE_INDEX_SYNC_PROVIDER_TOKEN=
UAIS_GRADEBOOK_RELEASE_PROVIDER=
UAIS_GRADEBOOK_RELEASE_PROVIDER_URL=
UAIS_GRADEBOOK_RELEASE_PROVIDER_TOKEN=
UAIS_COURSE_CONTENT_PUBLISH_PROVIDER=
UAIS_COURSE_CONTENT_PUBLISH_PROVIDER_URL=
UAIS_COURSE_CONTENT_PUBLISH_PROVIDER_TOKEN=
UAIS_COURSE_EXPORT_PROVIDER=
UAIS_COURSE_EXPORT_PROVIDER_URL=
UAIS_COURSE_EXPORT_PROVIDER_TOKEN=
UAIS_GRADING_FEEDBACK_PROVIDER=
UAIS_GRADING_FEEDBACK_PROVIDER_URL=
UAIS_GRADING_FEEDBACK_PROVIDER_TOKEN=

# Local JSON persistence paths for development and tests only. Production
# runtimes reject local JSON persistence and require external storage, so leave
# these unset in deployed lanes. Transcripts fall back to the courses directory
# when their dedicated path is unset.
UAIS_TEACHING_COURSES_DATA_DIR=
UAIS_LEARNING_CHATROOM_TRANSCRIPTS_DATA_DIR=

# Learning Record Store (xAPI) configuration
UAIS_LRS_ENDPOINT=
UAIS_LRS_USERNAME=
UAIS_LRS_PASSWORD=
UAIS_LRS_XAPI_VERSION=1.0.3
UAIS_LEARNING_RECORD_OUTBOX_SECRET=

# Observability configuration. Keep DSN/token values out of reports and logs.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=
UAIS_UPTIME_CHECK_URL=
UAIS_UPTIME_PROVIDER=

# Isolated staging and disposable DB evidence only. These names must stay
# unset in the uais production project. Secret values are supplied through the
# owner-approved staging source; generated SHA/URL/cohort values are non-secret
# but still release-bound and must not be guessed or copied from an older run.
UAIS_DB_TEST_DATABASE_URL=
UAIS_P1_LOAD_TEST_DATABASE_URL=
# Independent target attestations required before the mutation-capable DB suite
# can run. The nonce is secret-like; generate it for this isolated target and do
# not print it. Leave the explicit confirmation blank until the authorized run.
UAIS_DB_TEST_NEON_PROJECT_ID=
UAIS_DB_TEST_DSN_FINGERPRINT=
UAIS_DB_TEST_DSN_FINGERPRINT_NONCE=
UAIS_DB_TEST_LIVE_MUTATION_CONFIRMATION=
UAIS_P2_STAGING_DATABASE_URL=
UAIS_P2_STAGING_RESTORE_DATABASE_URL=
# Provider project identities for the isolated source and restore databases.
# Neither may equal the known UAIS production database identity, and the two
# staging identities must differ from each other.
NEON_PROJECT_ID=
RESTORE_NEON_PROJECT_ID=
P2_VERCEL_PROTECTION_BYPASS_SECRET=
P2_CANDIDATE_GIT_SHA=
# Generated with `node scripts/p2-staging-candidate-content.mjs`. next.config
# recomputes it from deployable source and fails a staging RUM build on mismatch.
P2_CANDIDATE_CONTENT_SHA=
P2_IMMUTABLE_DEPLOYMENT_URL=
UAIS_DEPLOYMENT_ENV=
UAIS_DEPLOYMENT_BASE_URL=
UAIS_STAGING_INP_RUM_ENABLED=
# Exact form: p2-inp-<40-char candidate Git SHA>-<unique 1..16 char run suffix>.
# Never reuse a cohort ID, including after its raw samples are purged.
UAIS_STAGING_INP_COHORT_ID=
UAIS_STAGING_INP_HMAC_SECRET=
# Non-secret rotation label bound into every route attestation and cohort row.
UAIS_STAGING_INP_HMAC_KEY_VERSION=
UAIS_STAGING_INP_OPERATOR_ACCOUNT_HASHES=
# At least 32 characters and distinct from the HMAC, app-session, and Vercel
# protection-bypass secrets. The staging build blocks before DB inspection if
# this is absent or reused.
CRON_SECRET=

# Per-actor spend guard for the learning chatroom. Enforced with safe defaults
# even when these are unset; set the mode to off only for local debugging.
UAIS_LEARNING_CHATROOM_RATE_LIMIT_MODE=enforce
UAIS_LEARNING_CHATROOM_RATE_LIMIT_PER_MINUTE=6
UAIS_LEARNING_CHATROOM_RATE_LIMIT_PER_DAY=120

# Group learning chatroom rollout; see docs/env-surface.md. The flag keeps
# group rooms disabled unless explicitly set to on; the history-read guard
# mirrors the round guard above and is enforced unless the mode is set to off.
# Durable storage is required once group chatrooms are enabled: production
# refuses local JSON. It needs no configuration here - a production runtime with
# UAIS_CORE_DATABASE_URL persists chatroom transcripts and share links on the
# managed Postgres by default. Set the trio below only to choose the external
# storage service instead. Check either path with
# `npm run release:chatroom-readiness`.
# UAIS_TEACHING_COURSE_MANAGEMENT_BACKEND=external
# UAIS_EXTERNAL_STORAGE_BASE_URL=https://storage.example.com
# UAIS_EXTERNAL_STORAGE_ACCESS_TOKEN=

# Only the exact literal `on` enables group rooms. `true`, `1` and `yes` all
# leave them off - the preflight above flags that mistake explicitly.
UAIS_LEARNING_CHATROOM_GROUPS_MODE=off
UAIS_LEARNING_CHATROOM_HISTORY_RATE_LIMIT_MODE=enforce
UAIS_LEARNING_CHATROOM_HISTORY_RATE_LIMIT_PER_MINUTE=30
UAIS_LEARNING_CHATROOM_HISTORY_RATE_LIMIT_PER_DAY=2000

# Teacher-requested P1 feedback drafts remain disabled until the owner approves
# a UAIS-specific provider credential source, cost boundary, and deployment lane.
UAIS_LEARNING_FEEDBACK_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_MULTIMODAL_MODEL=qwen3.5-omni-plus
QWEN_IMAGE_MODEL=qwen-image-2.0
QWEN_TTS_MODEL=qwen3-tts-vc-realtime-2026-01-15
